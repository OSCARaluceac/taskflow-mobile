{
    "version": 2,
    "cleanUrls": true,
    "framework": null,
    "rewrites": [
  { "source": "/((?!_expo|assets|favicon.ico|metadata.json).*)", "destination": "/index.html" }
],
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/(.*).js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript"
          }
        ]
      }
    ]
  }